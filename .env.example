# Resend (for inquiry notification emails — PRIMARY durable channel)
RESEND_API_KEY="re_..."
EMAIL_FROM="Manila Watch Atelier <notifications@manilawatch.com>"

# Anthropic Claude (for AI chatbot)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Vercel KV / Upstash Redis (durable data store for watches + inquiries).
# Auto-injected by Vercel when a KV store is linked to the project.
# For local dev: run `vercel env pull .env.local` after linking the project,
# or paste the REST credentials from the Upstash dashboard.
# If unset, api/_lib/data.ts falls back to reading src/data/inventory.json.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# Chat tuning (optional). Defaults assume Vercel Hobby (10s function timeout).
# For Vercel Pro (30s timeout), bump these.
# CHAT_TIME_BUDGET_MS="7000"
# CHAT_MAX_TOOL_CALLS="3"

# App Configuration
APP_URL="http://localhost:3000"
ADMIN_EMAIL="sherard@manilawatch.com"
WHATSAPP_NUMBER="639123456789"

# Admin Authentication
# Generate hash: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD'+process.env.SALT).digest('hex'))"
# NOTE: SHA-256 is the current algorithm; upgrading to scrypt is a P2 audit item.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="your_hashed_password_here"
SALT="generate_a_random_string_per_deployment"
