# Resend (for inquiry notification emails — PRIMARY durable channel)
RESEND_API_KEY="re_..."
EMAIL_FROM="Manila Watch Atelier <notifications@manilawatch.com>"

# Anthropic Claude (for AI chatbot)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Vercel Redis (durable data store for watches + inquiries).
# Vercel's marketplace rebranded "KV" to "Redis"; both naming schemes work.
# Vercel auto-injects these when a Redis store is linked to the project.
# For local dev: run `vercel env pull .env.local` after linking the project.
# If unset, api/_lib/data.ts falls back to reading src/data/inventory.json.
#
# Newer Upstash-direct naming (preferred by @upstash/redis):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# OR legacy Vercel KV naming (also accepted):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# Chat tuning (optional). Defaults assume Vercel Hobby (10s function timeout).
# For Vercel Pro (30s timeout), bump these.
# CHAT_TIME_BUDGET_MS="7000"
# CHAT_MAX_TOOL_CALLS="3"

# App Configuration
APP_URL="http://localhost:3000"
ADMIN_EMAIL="sherard@manilawatch.com"
WHATSAPP_NUMBER="639123456789"

# Admin Authentication
# Generate a scrypt hash (recommended):
#   echo -n 'your-password' | npm run hash:password
# The output starts with `scrypt$...` — paste it into ADMIN_PASSWORD_HASH.
#
# Legacy SHA-256 hashes (no `scrypt$` prefix) still work during transition:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD'+process.env.SALT).digest('hex'))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="your_hashed_password_here"
# SALT is only used by legacy SHA-256 hashes. New scrypt hashes carry their own
# salt internally; you can leave SALT unset once all admins have re-set passwords.
SALT="generate_a_random_string_per_deployment"

# HMAC token signing secret. Recommended over the legacy SALT+ADMIN_PASSWORD_HASH
# derivation because rotating the password no longer invalidates all tokens, and
# an ADMIN_PASSWORD_HASH leak no longer lets an attacker forge tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Min length: 32 characters.
TOKEN_SECRET=""
